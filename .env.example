# ChaosGate local workspace
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///data/chaosgate.db

# Optional default GitHub token (or paste it in the UI)
GITHUB_TOKEN=

# Gate policy defaults
GATE_REQUIRE_CONFIG=0
GATE_MAX_P95_MS=800
GATE_MAX_ERROR_RATE=0.05
GATE_FAIL_ON_SECRET=1

# Server
HOST=0.0.0.0
PORT=5000

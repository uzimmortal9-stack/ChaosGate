# ============================================================
# ChaosGate configuration. Copy to .env and edit.
# ============================================================

SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///data/chaosgate.db

# Server
HOST=0.0.0.0
PORT=5000
# Publicly reachable base URL. Required for GitHub OAuth callbacks and
# webhooks — GitHub cannot reach http://localhost.
PUBLIC_URL=

# ---------------------------------------------------------------- GitHub
# Option A — OAuth app (one-click sign-in).
#   Create at: https://github.com/settings/developers
#   Authorization callback URL: ${PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo,workflow,read:org

# Option B — personal access token (works with no setup; paste in the UI).
GITHUB_TOKEN=

# Shared secret for inbound webhook signature verification.
GITHUB_WEBHOOK_SECRET=

# --------------------------------------------------------------- Pushing
# branch_pr = push a chaosgate/* branch and open a PR (recommended)
# direct    = commit straight onto the default branch
PUSH_STRATEGY=branch_pr
PUSH_BRANCH_PREFIX=chaosgate
GIT_AUTHOR_NAME=ChaosGate
GIT_AUTHOR_EMAIL=gate@chaosgate.local

# ------------------------------------------------------------- Toolchain
# Stages run for real when these exist and degrade honestly when they do not.
DOCKER_BIN=docker
KUBECTL_BIN=kubectl
K6_BIN=k6
HELM_BIN=helm
DOCKER_BUILD=1
DOCKER_BUILD_TIMEOUT=600

# Kubernetes: 0 = validate with a server-side dry run only (safe default).
#             1 = actually apply manifests and wait for the rollout.
K8S_NAMESPACE=chaosgate
K8S_APPLY=0

# --------------------------------------------------------- Observability
# Leave blank to run without them; ChaosGate still serves /metrics and
# generates the Grafana dashboard as a downloadable artifact.
PROMETHEUS_URL=
PROMETHEUS_PUSHGATEWAY=
GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_FOLDER=ChaosGate

# --------------------------------------------------------------- Policy
GATE_REQUIRE_CONFIG=0
GATE_MAX_P95_MS=800
GATE_MAX_ERROR_RATE=0.05
GATE_FAIL_ON_SECRET=1
